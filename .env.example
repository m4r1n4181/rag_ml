# LLM
ANTHROPIC_API_KEY=your_api_key_here
LLM_MODEL=claude-haiku-4-5-20251001
# Set to none for newer Claude models that don't accept sampling parameters
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1500

# Embeddings (rebuild with `python build_db.py` after changing)
EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct
# Lighter alternative for weak hardware, noticeably worse retrieval (see data/eval/results.md):
# EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Retrieval
N_RESULTS=10
USE_HYBRID=false
USE_RERANKER=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
USE_QUERY_REWRITE=true

# Vector store
CHROMA_PATH=data/chroma_db
COLLECTION_NAME=faculty_rag
BATCH_SIZE=32

# Ingestion
TEXTBOOK_FILES=["MU_praktikum.pdf"]
CHUNK_SIZE=800
CHUNK_OVERLAP=150
USE_CONTEXT_HEADER=true

# Public demo: questions per browser session
MAX_QUESTIONS_PER_SESSION=20
